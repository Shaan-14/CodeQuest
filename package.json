{
  "name": "codequest",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "CodeQuest: a long-term browser-based educational RPG for independent technical problem solving.",
  "scripts": {
    "dev": "node scripts/copy-pyodide.mjs && vite",
    "build": "node scripts/copy-pyodide.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/copy-pyodide.mjs",
    "e2e": "npm run build && node e2e/run.mjs"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "codemirror": "^6.0.2",
    "preact": "^10.29.8",
    "pyodide": "^314.0.7"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
